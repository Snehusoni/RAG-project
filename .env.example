# =====================================================================
# API Keys (Provide at least one provider to power generation & embeddings)
# =====================================================================

# Google Gemini (Free API keys at: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Groq Cloud (Free high-speed Llama-3.1 inference: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (Optional: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# =====================================================================
# Vector Database & Storage Settings
# =====================================================================
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
COLLECTION_NAME=rag_document_collection

# =====================================================================
# RAG Chunking & Retrieval Hyperparameters
# =====================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_SEARCH_TYPE=similarity    # Options: 'similarity', 'mmr'
RETRIEVER_TOP_K=4
SCORE_THRESHOLD=0.35

# =====================================================================
# Default LLM Parameters
# =====================================================================
DEFAULT_LLM_PROVIDER=google         # Options: 'google', 'groq', 'openai'
DEFAULT_MODEL_NAME=gemini-1.5-flash # or 'llama-3.1-70b-versatile', 'gpt-4o-mini'
DEFAULT_EMBEDDING_PROVIDER=google   # Options: 'google', 'huggingface', 'openai'
TEMPERATURE=0.2
